<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="routing_definitions" targetNamespace="http://payments/routing">
  <bpmn:process id="payout_routing" name="Маршрутизация заявки на выплату" isExecutable="false">
    <bpmn:startEvent id="start" name="Заявка поступила">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="filter" name="Отсеять по жёстким условиям">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="any_eligible" name="Допустимые есть?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f_fallback_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="rank" name="Ранжировать взвешенным скорингом">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="send" name="Отправить заявку лучшему по рангу">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f_retry</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="response" name="Ответ">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f_accepted</bpmn:outgoing>
      <bpmn:outgoing>f_declined</bpmn:outgoing>
      <bpmn:outgoing>f_timeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="check_status" name="Сверить статус по operation_id">
      <bpmn:incoming>f_timeout</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="already_paid" name="Уже прошла?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f_paid</bpmn:outgoing>
      <bpmn:outgoing>f_not_paid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="candidates_left" name="Ещё кандидаты?">
      <bpmn:incoming>f_declined</bpmn:incoming>
      <bpmn:incoming>f_not_paid</bpmn:incoming>
      <bpmn:outgoing>f_retry</bpmn:outgoing>
      <bpmn:outgoing>f_fallback_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="fallback" name="Передать self-provider">
      <bpmn:incoming>f_fallback_1</bpmn:incoming>
      <bpmn:incoming>f_fallback_2</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reserve" name="Занять мощность и дождаться итога">
      <bpmn:incoming>f_accepted</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="settle" name="Освободить мощность, зачесть approved">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f_paid</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="done" name="Решение записано">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="filter" />
    <bpmn:sequenceFlow id="f2" sourceRef="filter" targetRef="any_eligible" />
    <bpmn:sequenceFlow id="f3" name="да" sourceRef="any_eligible" targetRef="rank" />
    <bpmn:sequenceFlow id="f_fallback_1" name="нет" sourceRef="any_eligible" targetRef="fallback" />
    <bpmn:sequenceFlow id="f4" sourceRef="rank" targetRef="send" />
    <bpmn:sequenceFlow id="f5" sourceRef="send" targetRef="response" />
    <bpmn:sequenceFlow id="f_accepted" name="принял" sourceRef="response" targetRef="reserve" />
    <bpmn:sequenceFlow id="f_declined" name="отказал" sourceRef="response" targetRef="candidates_left" />
    <bpmn:sequenceFlow id="f_timeout" name="не ответил" sourceRef="response" targetRef="check_status" />
    <bpmn:sequenceFlow id="f6" sourceRef="check_status" targetRef="already_paid" />
    <bpmn:sequenceFlow id="f_paid" name="да, не повторяем" sourceRef="already_paid" targetRef="settle" />
    <bpmn:sequenceFlow id="f_not_paid" name="нет, можно дальше" sourceRef="already_paid" targetRef="candidates_left" />
    <bpmn:sequenceFlow id="f_retry" name="да, следующий" sourceRef="candidates_left" targetRef="send" />
    <bpmn:sequenceFlow id="f_fallback_2" name="нет" sourceRef="candidates_left" targetRef="fallback" />
    <bpmn:sequenceFlow id="f7" sourceRef="fallback" targetRef="reserve" />
    <bpmn:sequenceFlow id="f8" sourceRef="reserve" targetRef="settle" />
    <bpmn:sequenceFlow id="f9" sourceRef="settle" targetRef="done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_payout_routing">
    <bpmndi:BPMNPlane id="BPMNPlane_payout_routing" bpmnElement="payout_routing">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="filter_di" bpmnElement="filter">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="any_eligible_di" bpmnElement="any_eligible" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rank_di" bpmnElement="rank">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_di" bpmnElement="send">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="response_di" bpmnElement="response" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reserve_di" bpmnElement="reserve">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="settle_di" bpmnElement="settle">
        <dc:Bounds x="1375" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="1557" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="candidates_left_di" bpmnElement="candidates_left" isMarkerVisible="true">
        <dc:Bounds x="1700" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fallback_di" bpmnElement="fallback">
        <dc:Bounds x="1825" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_status_di" bpmnElement="check_status">
        <dc:Bounds x="1075" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="already_paid_di" bpmnElement="already_paid" isMarkerVisible="true">
        <dc:Bounds x="1250" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fallback_1_di" bpmnElement="f_fallback_1">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="140" />
        <di:waypoint x="1875" y="140" />
        <di:waypoint x="1875" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_accepted_di" bpmnElement="f_accepted">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_declined_di" bpmnElement="f_declined">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="140" />
        <di:waypoint x="1725" y="140" />
        <di:waypoint x="1725" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_timeout_di" bpmnElement="f_timeout">
        <di:waypoint x="825" y="95" />
        <di:waypoint x="825" y="210" />
        <di:waypoint x="1075" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1375" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1475" y="70" />
        <di:waypoint x="1557" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_retry_di" bpmnElement="f_retry">
        <di:waypoint x="1725" y="95" />
        <di:waypoint x="1725" y="140" />
        <di:waypoint x="675" y="140" />
        <di:waypoint x="675" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fallback_2_di" bpmnElement="f_fallback_2">
        <di:waypoint x="1750" y="70" />
        <di:waypoint x="1825" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="1875" y="110" />
        <di:waypoint x="1875" y="140" />
        <di:waypoint x="975" y="140" />
        <di:waypoint x="975" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="1175" y="210" />
        <di:waypoint x="1250" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_paid_di" bpmnElement="f_paid">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1425" y="210" />
        <di:waypoint x="1425" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_not_paid_di" bpmnElement="f_not_paid">
        <di:waypoint x="1300" y="210" />
        <di:waypoint x="1725" y="210" />
        <di:waypoint x="1725" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
